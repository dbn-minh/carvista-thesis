NODE_ENV=development
APP_HOST=0.0.0.0
PORT=4000
APP_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
LOG_FORMAT=dev
JSON_LIMIT=2mb

# Database: prefer a single Railway/MySQL connection string in production
DATABASE_URL=mysql://user:password@localhost:3306/carvista
# Or use split variables instead
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carvista
DB_USER=user
DB_PASSWORD=password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Redis: optional cache + BullMQ queue backend
REDIS_URL=redis://localhost:6379
# CACHE_ENABLED=false makes all read APIs go straight to MySQL
CACHE_ENABLED=true
# QUEUE_ENABLED=false keeps notifications inline without BullMQ
QUEUE_ENABLED=true

# Default cache TTL (seconds) for generic cache entries
CACHE_TTL_SECONDS=300
# Catalog / lookup data changes rarely, so keep it longer
CATALOG_CACHE_TTL_SECONDS=1800
# Vehicle detail page cache
VEHICLE_DETAIL_CACHE_TTL_SECONDS=900
# Listing search results cache
LISTING_SEARCH_CACHE_TTL_SECONDS=180
# Listing detail cache
LISTING_DETAIL_CACHE_TTL_SECONDS=180
# TCO analysis cache
TCO_CACHE_TTL_SECONDS=3600
# Price outlook cache
PRICE_OUTLOOK_CACHE_TTL_SECONDS=1800

# Rate limiting (milliseconds + requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Local dev: allow any LAN hostname/IP on port 3000
CORS_ALLOWED_ORIGIN_PATTERNS=http://*:3000
# Example: https://*.vercel.app
CORS_ALLOW_CREDENTIALS=true

# Auth
JWT_SECRET=replace_me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
OTP_SECRET=replace_me
OTP_CODE_LENGTH=6
OTP_EXPIRES_IN_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_MAX_CHALLENGES_PER_HOUR=5
SOCIAL_STATE_SECRET=replace_me

# Social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# Notifications
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Media uploads
IMAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=carvista

# Pricing / intelligence
PRICE_DROP_THRESHOLD=0.03

# AI provider routing
# Local default: keep AI_PROVIDER=ollama and use the Ollama block below.
# Production/domain with FPT AI: set AI_PROVIDER=fpt and fill AI_BASE_URL / AI_API_KEY / AI_MODEL.
AI_PROVIDER=ollama
AI_BASE_URL=https://mkp-api.fptcloud.com
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_CHAT_COMPLETIONS_PATH=/chat/completions

# Local AI Advisor model via Ollama
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=30000

# Hosted AI via FPT AI Factory (OpenAI-compatible chat completions)
# Recommended base model to deploy on FPT: Qwen3-4B-Instruct-2507
# FPT may return a model identifier in the API Endpoint popup. Paste that identifier into FPT_AI_MODEL.
# You may use either the base API URL or the full /chat/completions endpoint URL here.
FPT_AI_BASE_URL=https://api.gptcloud.com/aiam/v1
FPT_AI_API_KEY=
FPT_AI_MODEL=
FPT_AI_TIMEOUT_MS=30000
