flowchart TB
  classDef frontend fill:#EAF2FF,stroke:#4E79C9,stroke-width:2px,color:#10223A;
  classDef backend fill:#E8F8F5,stroke:#2E8B78,stroke-width:2px,color:#0F2C27;
  classDef ai fill:#F3EEFF,stroke:#8A63D2,stroke-width:2px,color:#2D1E59;
  classDef data fill:#FFF7E8,stroke:#D49A2B,stroke-width:2px,color:#4B3411;
  classDef external fill:#FFF1F3,stroke:#D66A85,stroke-width:2px,color:#5B2030;
  classDef user fill:#FFFFFF,stroke:#6B7280,stroke-width:1.5px,color:#111827;

  user["Users<br/>buyers, sellers, admins"]

  subgraph FE["Frontend Layer"]
    direction TB
    pages["Next.js App Router pages<br/>home, catalog, listings, compare,<br/>sell, garage, profile, ai"]
    ui["React UI components<br/>forms, cards, dialogs,<br/>page intelligence, AI assistant"]
    api["API client layer<br/>apiFetch + carvista-api.ts"]
    pages --> ui --> api
  end

  subgraph BE["Backend API Layer"]
    direction TB
    app["Express app<br/>createApp(), CORS, JSON parser,<br/>logging, Swagger, req.ctx injection"]
    mw["Middleware<br/>requireAuth, role guards,<br/>validation, error handling"]
    routes["Route modules<br/>auth, catalog, listings, requests,<br/>reviews, watchlist, notifications,<br/>reports, admin, ai"]
    app --> mw --> routes
  end

  subgraph SERVICE["Service Layer"]
    direction LR
    domain["Domain services<br/>auth, social auth, listings, reviews,<br/>viewing requests, notifications,<br/>listing image storage"]
    aiRoutes["AI endpoints<br/>/ai/chat, /ai/compare,<br/>/ai/predict-price, /ai/tco"]
  end

  subgraph AI["AI and Decision Support Core"]
    direction LR
    orchestration["Conversation orchestration<br/>car_advisor_chat, chat_orchestrator,<br/>intent classifier, conversation routing"]
    analysis["Deterministic analysis services<br/>recommendation, compare_variants,<br/>predict_price, tco, page_intelligence,<br/>source retrieval, market trend logic"]
    insight["AI insight layer<br/>ai_insight.service<br/>summary, explanation, advisory wording"]
    llm["Qwen3 provider via ollama.service<br/>FPT AI Factory (primary)<br/>or Ollama-compatible runtime"]
  end

  subgraph DATA["Persistence and Data Layer"]
    direction TB
    orm["Sequelize + models<br/>req.ctx.models / req.ctx.tables"]
    tables["Application tables<br/>catalog, variants, specs, listings,<br/>saved cars, viewing requests, reviews,<br/>AI chat sessions, markets, TCO rules,<br/>price history, recalls, fuel economy,<br/>market signals, source references"]
    mysql["MySQL"]
    orm --> tables --> mysql
  end

  subgraph PIPE["Data Ingestion and Seed Layer"]
    direction LR
    seed["Seed and preparation scripts<br/>seed.py, normalize_vehicles.py,<br/>build_market_features.py"]
    ingest["Ingestion and refresh scripts<br/>ingest_price_history, ingest_market_listings,<br/>ingest_fuel_economy, ingest_safety_recalls,<br/>refresh_intelligence_materializations"]
    seed --> ingest
  end

  subgraph EXT["External Integrations"]
    direction LR
    docs["Swagger / OpenAPI"]
    oauth["Google + Facebook OAuth"]
    notify["Resend email + Twilio SMS"]
    media["Cloudinary image storage"]
    official["External vehicle data<br/>FuelEconomy.gov, NHTSA,<br/>internal marketplace provider"]
  end

  user --> FE --> BE
  api --> app
  routes --> domain
  routes --> aiRoutes

  aiRoutes --> orchestration
  aiRoutes --> analysis
  orchestration --> analysis
  analysis -->|structured result| insight
  orchestration -->|advisor final response| insight
  insight -->|strict prompt from backend JSON| llm
  routes -. "catalog or listing AI insights" .-> analysis

  domain --> orm
  orchestration --> orm
  analysis --> orm

  app --> docs
  domain --> oauth
  domain --> notify
  domain --> media
  official --> ingest --> mysql
  official -. "optional runtime enrichment" .-> analysis

  class user user;
  class pages,ui,api frontend;
  class app,mw,routes,domain,aiRoutes backend;
  class orchestration,analysis,insight,llm ai;
  class orm,tables,mysql,seed,ingest data;
  class docs,oauth,notify,media,official external;
